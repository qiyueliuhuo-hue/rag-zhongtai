# 复制本文件为 .env 后填入自己的真实值：cp .env.example .env
# .env 已被 .gitignore 排除，不会被提交。

# ── 图谱构建与通用 LLM（本地 Ollama 示例）──
LLM_API_KEY=<你的 LLM API Key；用本地 Ollama 可随意填占位符>
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# ── 对话/问答 LLM（DeepSeek）──
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=<你的 DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Neo4j 知识图谱 ──
# 注意：docker-compose.yml 里写死了 neo4j/neo4j123，改这里需同步改 compose
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<自行设置，别用默认值上线>

# ── Milvus 向量库 ──
# 容器内网络用 http://milvus:19530；本机直连用 http://localhost:19530
MILVUS_URI=http://localhost:19530

# ── 本地模型路径（Docker 内为 /models，见 docker-compose.yml）──
BGE_M3_PATH=./models/bge-m3
RERANKER_PATH=./models/bge-reranker-v2-m3
